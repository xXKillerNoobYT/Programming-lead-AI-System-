# DevLead MCP environment template
# Copy to `.env` for local defaults (do not commit real secrets).

# Path/config portability (absolute or repo-relative paths accepted)
REPORTS_DIR=./reports
DECISION_LOG_PATH=./decision-log.md
MCP_CONFIG_PATH=./.mcp.json
HEARTBEAT_PAUSE_LOCK_PATH=./.heartbeat-paused

# Heartbeat runtime tuning
HEARTBEAT_INTERVAL_MS=60000
MCP_CONNECT_TIMEOUT_MS=30000

# Required by scripts/spec-gate-bot.js
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=

# Existing project-level variables used by docs/.mcp.json
MEMPALACE_PALACE_PATH=
PLANS_VAULT_PATH=
FILESYSTEM_MCP_ROOT=
